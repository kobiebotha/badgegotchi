# Server-only values. Never put these in Flutter config or commit real keys.
# Local: supabase functions serve pet-ai --env-file supabase/functions/.env.local
# Hosted: set these in Supabase Dashboard > Edge Functions > Secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase runtime.
