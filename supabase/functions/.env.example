# Server-only values. Never put these in Flutter config or commit real keys.
# Local: supabase functions serve pet-ai --env-file supabase/functions/.env.local
# Hosted: set these in Supabase Dashboard > Edge Functions > Secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase runtime.

# Badge gateway: server-only secrets, never VITE_* or badge firmware constants.
# 32 random bytes encoded as 64 lowercase hex chars. Keep stable after pairing.
BADGE_HMAC_KEY=
# JSON private EC P-256 JWK (includes d); /jwks emits only the public x/y.
BADGE_SIGNING_JWK=
BADGE_SIGNING_KID=badge-v1
BADGE_POWERSYNC_URL=
BADGE_POWERSYNC_AUDIENCE=
